        {
          "type": "property",
          "id": "sb2024-18",
          "properties": [
            "cr"
          ],
          "display": "CR",
          "conditioned": true,
          "markdown": true,
          "callback": "const cr = String(monster.cr);\nif (monster.cr_detail) return `${cr} (${monster.cr_detail})`;\nconst XP = {\"0\":10,\"1/8\":25,\"1/4\":50,\"1/2\":100,\"1\":200,\"2\":450,\"3\":700,\"4\":1100,\"5\":1800,\"6\":2300,\"7\":2900,\"8\":3900,\"9\":5000,\"10\":5900,\"11\":7200,\"12\":8400,\"13\":10000,\"14\":11500,\"15\":13000,\"16\":15000,\"17\":18000,\"18\":20000,\"19\":22000,\"20\":25000,\"21\":33000,\"22\":41000,\"23\":50000,\"24\":62000,\"25\":75000,\"26\":90000,\"27\":105000,\"28\":120000,\"29\":135000,\"30\":155000};\nconst [a, b] = cr.split(\"/\");\nconst val = b ? Number(a) / Number(b) : Number(cr);\nconst pb = Math.max(2, Math.floor(2 + (val - 1) / 4));\nreturn cr in XP ? `${cr} (XP ${XP[cr].toLocaleString(\"en-US\")}; PB +${pb})` : cr;"
        }
      ]
