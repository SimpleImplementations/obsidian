          "id": "sb2024-11",
          "properties": [
            "skillsaves"
          ],
          "display": "Skills",
          "conditioned": true,
          "markdown": true,
          "callback": "let s = monster.skillsaves;\nif (s && !Array.isArray(s) && typeof s === \"object\") s = Object.entries(s).map(([k, v]) => ({ [k]: v }));\nreturn (s || []).map(o => {\n  const [k, v] = Object.entries(o)[0];\n  const name = k.charAt(0).toUpperCase() + k.slice(1);\n  return typeof v === \"number\" ? `${name} ${v >= 0 ? \"+\" : \"\"}${v}` : `${name} ${v}`;\n}).join(\", \");"
        },
