    {
      "type": "group",
      "id": "sb2024-8",
      "properties": [
        "stats"
      ],
      "hasRule": true,
      "conditioned": true,
      "nested": [
        {
          "type": "javascript",
          "id": "sb2024-9",
          "code": "const m = monster;\nconst st = Array.isArray(m.stats) ? m.stats : [];\nif (st.length < 6) return;\nconst keys = [\"str\", \"dex\", \"con\", \"int\", \"wis\", \"cha\"];\nlet sv = m.saves;\nif (sv && !Array.isArray(sv) && typeof sv === \"object\") sv = Object.entries(sv).map(([k, v]) => ({ [k]: v }));\nconst saves = {};\nfor (const o of sv || []) for (const [k, v] of Object.entries(o)) saves[String(k).slice(0, 3).toLowerCase()] = Number(v);\nconst fmt = n => (n >= 0 ? \"+\" : \"-\") + Math.abs(n);\nconst table = createEl(\"table\", { cls: \"statblock-2024-stats\" });\ntable.setAttr(\"style\", \"width:100%;border-collapse:collapse;text-align:center;margin:0.25em 0;\");\nconst head = table.createEl(\"tr\");\nfor (let g = 0; g < 2; g++) {\n  head.createEl(\"th\"); head.createEl(\"th\");\n  head.createEl(\"th\", { text: \"MOD\" }); head.createEl(\"th\", { text: \"SAVE\" });\n}\nfor (let r = 0; r < 3; r++) {\n  const tr = table.createEl(\"tr\");\n  for (const i of [r, r + 3]) {\n    const k = keys[i];\n    const score = Number(st[i] ?? 10);\n    const mod = Math.floor((score - 10) / 2);\n    tr.createEl(\"th\", { text: k.toUpperCase() });\n    tr.createEl(\"td\", { text: String(score) });\n    tr.createEl(\"td\", { text: fmt(mod) });\n    tr.createEl(\"td\", { text: fmt(k in saves ? saves[k] : mod) });\n  }\n}\nreturn table;"
        }
      ]
    },
    {
