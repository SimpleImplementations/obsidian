    {
      "type": "property",
      "id": "sb2024-2",
      "properties": [
        "size",
        "type",
        "subtype",
        "alignment"
      ],
      "display": "",
      "conditioned": true,
      "markdown": true,
      "callback": "const m = monster;\nlet t = [m.size, m.type].filter(x => x).join(\" \");\nif (m.subtype) t += ` (${m.subtype})`;\nif (m.alignment) t += (t ? \", \" : \"\") + m.alignment;\nreturn t ? `*${t}*` : \"\";"
    },
    {
      "type": "group",
      "id": "sb2024-3",
      "properties": [
        "ac",
        "initiative",
        "hp",
        "speed"
      ],
      "hasRule": true,
      "conditioned": true,
      "nested": [
        {
          "type": "property",
          "id": "sb2024-4",
          "properties": [
            "ac"
          ],
          "display": "AC",
          "conditioned": true,
          "markdown": true,
          "callback": "return monster.ac_class ? `${monster.ac} (${monster.ac_class})` : String(monster.ac);"
        },
        {
          "type": "property",
